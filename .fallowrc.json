{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/main.tsx"],
  "boundaries": {
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["tools/**", "*.config.ts", "public/editor/vendor/**"]
    },
    "zones": [
      {
        "name": "tests",
        "patterns": ["src/**/*.test.ts", "src/test-fixtures.ts", "tests/**"]
      },
      {
        "name": "editor",
        "patterns": ["src/features/editor/**"]
      },
      {
        "name": "landing",
        "patterns": ["src/features/landing/**"]
      },
      {
        "name": "contracts",
        "patterns": ["src/contracts/**"]
      },
      {
        "name": "narrative",
        "patterns": ["src/features/story-runtime/ink-engine.ts"]
      },
      {
        "name": "runtime",
        "patterns": ["src/features/story-runtime/director.ts"]
      },
      {
        "name": "persistence",
        "patterns": ["src/persistence/**"]
      },
      {
        "name": "content",
        "patterns": ["src/features/story-runtime/bundle-loader.ts"]
      },
      {
        "name": "reader",
        "patterns": ["src/features/reader/**"]
      },
      {
        "name": "i18n",
        "patterns": ["src/i18n/**"]
      },
      {
        "name": "app",
        "patterns": ["src/app/**", "src/main.tsx", "index.html"]
      },
      {
        "name": "presentation",
        "patterns": ["src/features/presentation/**"]
      },
      {
        "name": "character",
        "patterns": ["src/features/character/**"]
      },
      {
        "name": "media",
        "patterns": ["src/features/media/**"]
      }
    ],
    "rules": [
      {
        "from": "tests",
        "allow": [
          "contracts",
          "narrative",
          "runtime",
          "persistence",
          "content",
          "reader",
          "i18n",
          "app",
          "landing",
          "presentation",
          "character",
          "media",
          "editor"
        ]
      },
      {
        "from": "contracts",
        "allow": []
      },
      {
        "from": "narrative",
        "allow": ["contracts"]
      },
      {
        "from": "runtime",
        "allow": ["contracts"]
      },
      {
        "from": "persistence",
        "allow": ["contracts"]
      },
      {
        "from": "content",
        "allow": ["contracts"]
      },
      {
        "from": "reader",
        "allow": ["contracts", "presentation", "character"],
        "allowTypeOnly": ["runtime"]
      },
      {
        "from": "i18n",
        "allow": []
      },
      {
        "from": "app",
        "allow": [
          "contracts",
          "narrative",
          "runtime",
          "persistence",
          "content",
          "reader",
          "i18n",
          "landing",
          "character",
          "media",
          "presentation",
          "editor"
        ]
      },
      {
        "from": "editor",
        "allow": ["contracts", "persistence", "media", "presentation"]
      },
      {
        "from": "landing",
        "allow": ["contracts"]
      },
      {
        "from": "presentation",
        "allow": ["contracts", "media"]
      },
      {
        "from": "character",
        "allow": ["contracts"]
      },
      {
        "from": "media",
        "allow": ["contracts"]
      }
    ]
  },
  "ignoreFindings": ["src/features/presentation/react-bits/vendor/**", "public/editor/vendor/**"],
  "health": {
    "ignore": ["src/features/presentation/react-bits/vendor/**", "public/editor/vendor/**"]
  },
  "duplicates": {
    "ignore": ["src/features/presentation/react-bits/vendor/**", "public/editor/vendor/**"]
  }
}
