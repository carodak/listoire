import type { StoryProject } from "../../contracts/editor-project.ts";
import type { ComposerHandle } from "../../experiments/book-scene3d/SceneComposer.tsx";
import type { MediaEdit } from "./media-authoring.ts";

export async function prepareSceneMedia(
  project: StoryProject,
  locale: string,
  input: MediaEdit,
  composer: ComposerHandle,
) {
  input.motion = { ...input.motion, layers: [] };
  const registered = await composer.prepare(input.motion);
  const media = registered.at(-1)!;
  input.asset = media.id;
  input.duration = media.upload?.durationMs ?? input.duration;
  if (media.type === "video") input.examination = null;
  const language = project.languages[locale]!;
  const next: StoryProject = {
    ...project,
    languages: {
      ...project.languages,
      [locale]: {
        ...language,
        configuration: {
          ...language.configuration,
          assets: [
            ...(language.configuration.assets ?? []).filter(
              (item) => !registered.some((asset) => asset.id === item.id),
            ),
            ...registered,
          ],
        },
      },
    },
    mediaLibrary: [
      ...(project.mediaLibrary ?? []).filter(
        (entry) => !registered.some((asset) => asset.id === entry.id),
      ),
      ...registered.map((asset) => ({
        id: asset.id,
        title: asset.alt,
        category: asset.scene3d ? "3D Scene" : "3D Model",
        themes: [],
        usage: asset.model3d?.roles ?? ["illustration"],
      })),
    ],
  };
  const uploads = new Map(
    Object.values(next.languages).flatMap((language) =>
      (language.configuration.assets ?? []).map((asset) => [asset.id, asset]),
    ),
  );
  const bytes = [...uploads.values()].reduce((sum, asset) => sum + (asset.upload?.size ?? 0), 0);
  if (bytes > 130_000_000)
    throw new Error(
      "Project media exceed 130 MB. Reduce unused assets to keep complete backups below the 200 MB import limit.",
    );
  return next;
}
