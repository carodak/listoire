import {
  BackSide,
  DoubleSide,
  Color,
  Group,
  Mesh,
  PlaneGeometry,
  ShaderMaterial,
  SphereGeometry,
  InstancedMesh,
  BufferGeometry,
  Float32BufferAttribute,
  Object3D,
} from "three";
import type { Scene3D } from "../../contracts/scene3d.ts";
import { illustrationMaterial } from "../synty-parallax/materials.ts";
import { brushFunctions } from "../synty-parallax/surface-shaders.ts";

const random = (n: number) => {
  const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
  return x - Math.floor(x);
};

function earth(data: Scene3D) {
  const forest = data.environment === "forest";
  const material = illustrationMaterial(data.style, null);
  const paint = material.onBeforeCompile;
  material.onBeforeCompile = (shader, renderer) => {
    paint.call(material, shader, renderer);
    Object.assign(shader.uniforms, {
      soilColor: { value: new Color(forest ? "#6d5840" : "#987548") },
      mossColor: { value: new Color(forest ? "#384b2d" : "#62643a") },
      stoneColor: { value: new Color("#b1a087") },
    });
    shader.fragmentShader = shader.fragmentShader
      .replace(
        "#include <common>",
        "#include <common>\nuniform vec3 soilColor; uniform vec3 mossColor; uniform vec3 stoneColor;",
      )
      .replace(
        "#include <color_fragment>",
        `#include <color_fragment>
        { vec2 soilUV = vBrushPosition.xz;
        float path = 1.0-smoothstep(1.25,2.8,abs(soilUV.x-sin(soilUV.y*0.18)*0.65));
        float patches = brushNoise(soilUV*1.8);
        float grit = brushNoise(soilUV*43.0);
        diffuseColor.rgb = mix(mossColor,soilColor,path) * (0.66+patches*0.5+grit*0.18);
        float pebble = smoothstep(0.78,0.87,brushNoise(soilUV*13.0))*path;
        diffuseColor.rgb = mix(diffuseColor.rgb,stoneColor,pebble*0.65); }
      `,
      );
  };
  material.customProgramCacheKey = () => `earth-${data.style}-${forest}`;
  const ground = new Mesh(new PlaneGeometry(240, 240), material);
  ground.rotation.x = -Math.PI / 2;
  ground.position.y = -0.025;
  ground.receiveShadow = true;
  ground.name = "Earth and winding path";
  return ground;
}

function sky(data: Scene3D, horizon: string) {
  const paper = data.style === "sketch";
  const material = new ShaderMaterial({
    side: BackSide,
    depthWrite: false,
    uniforms: {
      topColor: {
        value: new Color(paper ? "#eee9de" : data.ambience === "moonlight" ? "#111b32" : "#526477"),
      },
      horizonColor: { value: new Color(horizon) },
      cloudColor: {
        value: new Color(paper ? "#fffdf5" : data.ambience === "moonlight" ? "#627186" : "#e5cba3"),
      },
    },
    vertexShader:
      "varying vec3 vSky; void main(){vSky=position; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}",
    fragmentShader: `${brushFunctions}
      varying vec3 vSky; uniform vec3 topColor; uniform vec3 horizonColor; uniform vec3 cloudColor;
      void main(){
        vec3 direction=normalize(vSky); float height=clamp(direction.y,0.0,1.0);
        vec3 color=mix(horizonColor,topColor,smoothstep(0.0,0.65,height));
        vec2 cloudUV=direction.xz/(0.18+abs(direction.y))*1.7;
        float cloud=brushNoise(cloudUV)*0.65+brushNoise(cloudUV*2.7)*0.35;
        color=mix(color,cloudColor,smoothstep(0.48,0.75,cloud)*0.55);
        float glow=pow(max(dot(direction,normalize(vec3(-0.7,0.35,-0.8))),0.0),18.0);
        color+=cloudColor*glow*0.45;
        gl_FragColor=vec4(color,1.0);
        #include <tonemapping_fragment>
        #include <colorspace_fragment>
      }`,
  });
  const dome = new Mesh(new SphereGeometry(120, 24, 16), material);
  dome.name = "Clouded atmospheric sky";
  return dome;
}

function meadow(data: Scene3D) {
  const geometry = new BufferGeometry();
  const blade = [
    -0.055, 0, 0, 0.055, 0, 0, 0.025, 0.32, 0.02, -0.055, 0, 0, 0.025, 0.32, 0.02, -0.02, 0.32,
    0.02, -0.02, 0.32, 0.02, 0.025, 0.32, 0.02, 0.045, 0.6, 0.06,
  ];
  const clump = Array.from({ length: 5 }, (_, i) =>
    Array.from({ length: 9 }, (_, v) => {
      const angle = i * 2.4,
        x = blade[v * 3]!,
        y = blade[v * 3 + 1]!,
        z = blade[v * 3 + 2]!;
      return [
        x * Math.cos(angle) + z * Math.sin(angle) + Math.sin(angle) * 0.08,
        y * (0.6 + i * 0.12),
        z * Math.cos(angle) - x * Math.sin(angle),
      ];
    }).flat(),
  ).flat();
  geometry.setAttribute("position", new Float32BufferAttribute(clump, 3));
  geometry.computeVertexNormals();
  const material = illustrationMaterial(data.style, null, "#727c42");
  material.side = DoubleSide;
  const grass = new InstancedMesh(geometry, material, 1200);
  const pose = new Object3D();
  let count = 0;
  for (let i = 0; i < 2000 && count < 1200; i++) {
    const x = (random(i * 3) - 0.5) * 22,
      z = random(i * 3 + 1) * 34 - 26;
    if (Math.abs(x - Math.sin(z * 0.18) * 0.65) < 1.65) continue;
    pose.position.set(x, 0, z);
    pose.rotation.set(0, random(i * 3 + 2) * Math.PI * 2, 0);
    pose.scale.setScalar(0.35 + random(i + 900) * 0.65);
    pose.updateMatrix();
    grass.setMatrixAt(count, pose.matrix);
    grass.setColorAt(
      count,
      new Color().setHSL(0.18 + random(i + 99) * 0.07, 0.32, 0.3 + random(i + 20) * 0.18),
    );
    count++;
  }
  grass.count = count;
  grass.receiveShadow = true;
  grass.name = "Grass along the path";
  return grass;
}

export function buildEnvironment(data: Scene3D, horizon: string) {
  const group = new Group();
  group.name = "Terrain, sky and vegetation";
  group.add(earth(data), sky(data, horizon), meadow(data));
  for (let i = 0; i < 9; i++) {
    const hill = new Mesh(
      new SphereGeometry(1, 8, 5),
      illustrationMaterial(data.style, null, "#59604f"),
    );
    hill.position.set((i - 4) * 15, -3, -55 - random(i) * 15);
    hill.scale.set(12 + random(i + 10) * 10, 5 + random(i + 22) * 8, 12);
    group.add(hill);
  }
  return group;
}
