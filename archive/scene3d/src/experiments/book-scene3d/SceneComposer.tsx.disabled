import { sceneTemplate } from "./templates.ts";
import { QuickScene } from "./QuickScene.tsx";
import { commitSceneCamera, replaceSceneElement, appendSceneModel } from "./composition.ts";
import type { ModelSource } from "./models.ts";
import { Viewport } from "./Viewport.tsx";
import { useCallback, useEffect, useImperativeHandle, useRef, useReducer, useState } from "react";
import type { Ref } from "react";
import type { Cinematic } from "../../contracts/cinematic.ts";
import type { Scene3D } from "../../contracts/scene3d.ts";
import type { MediaAsset } from "../../contracts/uploaded-media.ts";
import { modelSources } from "./models.ts";
import { compositionExport } from "./export.ts";
import { Gallery } from "./Gallery.tsx";
import { SceneLayers } from "./SceneLayers.tsx";
import { ModelImport } from "./ModelImport.tsx";
import {
  CompositionFields,
  TransformFields,
  CameraFields,
  CompositionFeedback,
} from "./CompositionFields.tsx";
import { BookDraft } from "./BookDraft.tsx";
import { useSceneSurface } from "./use-scene-surface.ts";
import type { Tool } from "./controls.ts";
import "./composer.css";
interface ComposerView {
  selected: number;
  tool: Tool;
  layer: Scene3D["elements"][number]["layer"];
  moving: boolean;
  status: { busy: boolean; progress: number; error: string };
}
export interface ComposerHandle {
  prepare: (motion: Cinematic) => Promise<MediaAsset[]>;
}
export default function SceneComposer({
  assets,
  assetId,
  motion,
  layout,
  ref,
  onReady,
}: {
  assets: MediaAsset[];
  assetId: string;
  motion: Cinematic;
  layout: string;
  ref: Ref<ComposerHandle>;
  onReady?: (ready: boolean) => void;
}) {
  const [scene, setScene] = useState(
    () => assets.find((asset) => asset.id === assetId)?.scene3d ?? sceneTemplate("village", motion),
  );
  const [imports, setImports] = useState<MediaAsset[]>([]);
  const [draft, setDraft] = useState("");
  const [view, patchView] = useReducer(
    (before: ComposerView, change: Partial<ComposerView>) => ({ ...before, ...change }),
    {
      selected: 0,
      tool: "camera",
      layer: "main",
      moving: false,
      status: { busy: false, progress: 0, error: "" },
    },
  );
  const { selected, tool, layer, moving, status } = view;
  const setSelected = useCallback((selected: number) => patchView({ selected }), []);
  const setTool = (tool: Tool) => patchView({ tool });
  const setLayer = (layer: Scene3D["elements"][number]["layer"]) => patchView({ layer });
  const setMoving = (moving: boolean) => patchView({ moving });
  function setStatus(value: React.SetStateAction<ComposerView["status"]>) {
    patchView({ status: typeof value === "function" ? value(status) : value });
  }
  const canvas = useRef<HTMLCanvasElement>(null);
  const sources = modelSources([...assets, ...imports]);
  const composition = JSON.stringify({
    ...scene,
    title: "Illustration preview",
    cinematic: { ...motion, layers: [] },
  });
  const sourceKey = JSON.stringify(sources);
  const commit = useCallback(
    (
      camera: NonNullable<Scene3D["camera"]>,
      transform?: Scene3D["elements"][number]["transform"],
      index?: number,
    ) => {
      setScene((before) => commitSceneCamera(before, camera, transform, index));
    },
    [],
  );
  const { runtime, error } = useSceneSurface(
    canvas,
    composition,
    sourceKey,
    layout === "right",
    setSelected,
    commit,
    setDraft,
  );
  useEffect(() => {
    runtime?.controls.select(selected, tool);
    runtime?.setPlaying(moving);
    onReady?.(Boolean(runtime) && !error);
  }, [runtime, selected, tool, moving, error, onReady]);
  useImperativeHandle(ref, () =>
    compositionExport({
      runtime,
      error,
      scene,
      sources,
      imports,
      onState: (busy, progress) => setStatus((before) => ({ ...before, busy, progress })),
    }),
  );

  const element = scene.elements[selected],
    source = sources.find((source) => source.id === element?.assetId);
  function updateElement(element: Scene3D["elements"][number]) {
    setScene(
      replaceSceneElement(
        { ...scene, camera: runtime?.controls.readCamera() ?? scene.camera },
        selected,
        element,
      ),
    );
  }
  function addModel(source: ModelSource) {
    try {
      const next = appendSceneModel(scene, source.id, layer, source.placementScale?.[layer] ?? 1);
      setSelected(scene.elements.length);
      setScene(next);
      setStatus({ ...status, error: "" });
    } catch (error) {
      setStatus({ ...status, error: String(error) });
    }
  }
  return (
    <fieldset className="scene3d-composer" disabled={status.busy}>
      <legend className="sr-only">3D illustration</legend>
      <QuickScene
        scene={scene}
        sources={sources}
        onChange={(scene) => {
          setScene(scene);
          setSelected(0);
        }}
      />
      <aside className="composition-library">
        <Gallery sources={sources} layer={layer} onLayer={setLayer} onAdd={addModel} />
        <SceneLayers
          scene={scene}
          sources={sources}
          selected={selected}
          onSelect={setSelected}
          onChange={setScene}
          onAdd={setLayer}
        />
        <ModelImport
          onImport={(asset) =>
            setImports((before) => [...before.filter((item) => item.id !== asset.id), asset])
          }
        />
      </aside>
      <section className="composition-stage">
        <div className="composition-heading">
          <label>
            Illustration name
            <input
              maxLength={100}
              value={scene.title}
              onChange={(event) => setScene({ ...scene, title: event.target.value })}
            />
          </label>
          <p>Choose a look and shot, then drag the preview to frame your illustration.</p>
        </div>
        <CompositionFields scene={scene} onChange={setScene} />
        <Viewport
          canvas={canvas}
          canvasKey={composition + sourceKey + (layout === "right")}
          ready={Boolean(runtime)}
          tool={tool}
          onTool={setTool}
          onFrame={() => setScene({ ...scene, camera: undefined })}
        />
        <div className="composition-inspector">
          <details open={!["camera", "pan"].includes(tool)}>
            <summary>Adjust selected object</summary>
            <TransformFields element={element} source={source} onChange={updateElement} />
          </details>
          <CameraFields
            scene={scene}
            runtime={runtime}
            moving={moving}
            onChange={setScene}
            onMotion={() => setMoving(!moving)}
          />
        </div>
        <CompositionFeedback runtime={runtime} error={error} status={status} />
      </section>
      <BookDraft
        image={draft}
        layout={layout}
        blend={scene.blend ? (scene.blendMode ?? "atmospheric") : "none"}
        edges={scene.pageEdges ?? "none"}
      />
    </fieldset>
  );
}
