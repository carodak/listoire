import { useState } from "react";
import type { MediaAsset } from "../../contracts/uploaded-media.ts";
import type { Model3D } from "../../contracts/scene3d.ts";
import { importModel } from "./models.ts";
export function ModelImport({ onImport }: { onImport: (asset: MediaAsset) => void }) {
  const [draft, setDraft] = useState({
    rights: "",
    category: "character" as Model3D["category"],
    busy: false,
    error: "",
  });
  return (
    <details>
      <summary>Import a 3D model (GLB, up to 20 MB)</summary>
      <label>
        Model category
        <select
          value={draft.category}
          onChange={(e) => setDraft({ ...draft, category: e.target.value as Model3D["category"] })}
        >
          {["character", "architecture", "environment", "nature", "object"].map((value) => (
            <option key={value}>{value}</option>
          ))}
        </select>
      </label>
      <label>
        Model permission / rights
        <input
          maxLength={500}
          value={draft.rights}
          onChange={(e) => setDraft({ ...draft, rights: e.target.value })}
        />
      </label>
      <label>
        GLB file
        <input
          type="file"
          accept=".glb,model/gltf-binary"
          disabled={draft.busy}
          onChange={(e) => {
            const file = e.target.files?.[0];
            e.target.value = "";
            if (!file) return;
            setDraft({ ...draft, busy: true, error: "" });
            void importModel(file, draft.category, draft.rights)
              .then(onImport)
              .then(() => setDraft((draft) => ({ ...draft, busy: false })))
              .catch((error: unknown) =>
                setDraft((draft) => ({ ...draft, busy: false, error: String(error) })),
              );
          }}
        />
      </label>
      {draft.busy && <p role="status">Verifying model…</p>}
      {draft.error && <p role="alert">{draft.error}</p>}
      <p>
        Use embedded textures and an uncompressed GLB. Maximum 250,000 vertices and 500 nodes.
        Category determines safe scale and depth layers.
      </p>
    </details>
  );
}
