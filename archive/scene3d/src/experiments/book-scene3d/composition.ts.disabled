import { Box3, Vector3 } from "three";
import type { Object3D, PerspectiveCamera } from "three";
import type { Scene3D, Model3D } from "../../contracts/scene3d.ts";
import { sampleCinematic } from "../../features/presentation/cinematic-presets.ts";

export function replaceSceneElement(
  scene: Scene3D,
  index: number,
  element: Scene3D["elements"][number],
) {
  if (!scene.elements[index]) return scene;
  const elements = scene.elements.slice();
  elements[index] = element;
  return { ...scene, elements };
}
export function commitSceneCamera(
  scene: Scene3D,
  camera: NonNullable<Scene3D["camera"]>,
  transform?: Scene3D["elements"][number]["transform"],
  index?: number,
) {
  const next = { ...scene, camera };
  const element = index === undefined ? undefined : scene.elements[index];
  return element && transform ? replaceSceneElement(next, index!, { ...element, transform }) : next;
}
export function appendSceneModel(
  scene: Scene3D,
  assetId: string,
  layer: Scene3D["elements"][number]["layer"],
  scale = 1,
) {
  const limits = { main: 2, background: 3, midground: 4, foreground: 3 };
  if (
    scene.elements.length >= 12 ||
    scene.elements.filter((element) => element.layer === layer).length >= limits[layer]
  )
    throw new Error(`No more ${layer} slots. Remove a model first.`);
  const placed = scene.elements.filter((element) => element.layer === layer);
  const occupied = placed.map((element, i) =>
    new Vector3(...anchors[layer][i]!).add(element.transform?.position ?? { x: 0, y: 0, z: 0 }),
  );
  const free =
    anchors[layer].find((anchor) =>
      occupied.every((position) => position.distanceTo(new Vector3(...anchor)) > 1),
    ) ?? anchors[layer][placed.length]!;
  const element = shiftAnchor({ assetId, layer }, free, anchors[layer][placed.length]!);
  element.transform.scale = scale;
  return { ...scene, elements: [...scene.elements, element] };
}

function shiftAnchor(element: Scene3D["elements"][number], from: number[], to: number[]) {
  const transform = element.transform ?? {
    position: { x: 0, y: 0, z: 0 },
    rotation: { x: 0, y: 0, z: 0 },
    scale: 1,
  };
  const position = new Vector3(...from).sub(new Vector3(...to)).add(transform.position);
  return {
    ...element,
    transform: { ...transform, position: { x: position.x, y: position.y, z: position.z } },
  };
}

export function removeSceneElement(scene: Scene3D, index: number) {
  const layer = scene.elements[index]?.layer;
  if (!layer) return scene;
  let before = 0,
    after = 0;
  const elements = scene.elements.flatMap((element, at) => {
    if (element.layer !== layer) return [element];
    const from = anchors[layer][before++]!;
    return at === index ? [] : [shiftAnchor(element, from, anchors[layer][after++]!)];
  });
  return { ...scene, elements };
}

const heights = { character: 1.8, architecture: 5, environment: 10, nature: 3.2, object: 0.9 };
const anchors = {
  main: [
    [0, 0, 0],
    [2.1, 0, -0.2],
  ],
  background: [
    [0, 0, -12],
    [-11, 0, -15],
    [11, 0, -15],
  ],
  midground: [
    [-6, 0, -6],
    [6, 0, -6],
    [-11, 0, -4],
    [11, 0, -4],
  ],
  foreground: [
    [-1.8, 0, 0.8],
    [2.1, 0, 1],
    [-3, 0, 1],
  ],
};
export function placeModel(
  root: Object3D,
  metadata: Model3D,
  layer: Scene3D["elements"][number]["layer"],
  index: number,
) {
  const bounds = new Box3().setFromObject(root);
  const size = bounds.getSize(new Vector3());
  if (!Number.isFinite(size.length()) || size.length() < 0.0001)
    throw new Error("This model has no visible geometry.");
  const maxWidth = layer === "main" ? 2 : layer === "background" ? 18 : 5;
  const scale = Math.min(
    heights[metadata.category] / Math.max(size.y, 0.001),
    maxWidth / Math.max(size.x, size.z, 0.001),
  );
  root.scale.multiplyScalar(scale);
  const center = bounds.getCenter(new Vector3()).multiplyScalar(scale);
  const anchor = anchors[layer][index];
  if (!anchor) throw new Error(`No remaining placement anchors in ${layer}.`);
  root.position.add(
    new Vector3(anchor[0], anchor[1], anchor[2]).sub(
      new Vector3(center.x, bounds.min.y * scale, center.z),
    ),
  );
  root.updateMatrixWorld(true);
  return new Box3().setFromObject(root);
}
export function avoidOverlap(box: Box3, existing: Box3[]) {
  const footprint = box.clone();
  footprint.min.y = -0.1;
  footprint.max.y = 0.1;
  if (existing.some((other) => footprint.intersectsBox(other)))
    throw new Error(
      "These structures overlap. Remove an element or move it to a different depth layer.",
    );
  existing.push(footprint);
}
export function cameraFraming(
  bounds: Box3,
  aspect: number,
  shot: Scene3D["shot"],
  character = false,
) {
  const center = bounds.getCenter(new Vector3());
  const size = bounds.getSize(new Vector3());
  if (shot === "close" && character) {
    center.y += size.y * 0.25;
    size.y *= 0.55;
  }
  const framing = { close: 1.05, medium: 1.3, wide: 2.2 }[shot];
  const distance =
    (Math.max(size.y, size.x / aspect, 0.6) / (2 * Math.tan(Math.PI / 8))) * framing + size.z / 2;
  return { target: center, distance };
}

export function sceneFocus(objects: Object3D[], elements: Scene3D["elements"]) {
  const visible = elements
    .map((element, index) => ({ element, index }))
    .filter(({ element }) => element.visible !== false);
  const subjects = visible.filter(({ element }) => element.layer === "main");
  const scenery = visible.filter(({ element }) => element.layer !== "foreground");
  const candidates = subjects.length
    ? subjects
    : scenery.length
      ? scenery
      : visible.length
        ? visible
        : elements.map((element, index) => ({ element, index }));
  const bounds = new Box3();
  for (const { index } of candidates) bounds.union(new Box3().setFromObject(objects[index]!));
  return { bounds, subjects: subjects.map(({ element }) => element) };
}
export function animateCamera(
  camera: PerspectiveCamera,
  scene: Scene3D,
  frame: ReturnType<typeof cameraFraming>,
  progress: number,
) {
  const motion = sampleCinematic(scene.cinematic, progress);
  const shift =
    { left: 0.25, center: 0, right: -0.25 }[scene.position] * frame.distance * camera.aspect;
  const base = scene.camera;
  if (base) {
    camera.fov = base.fov;
    camera.position.copy(base.position);
    camera.lookAt(base.target.x, base.target.y, base.target.z);
    camera.updateMatrix();
    const right = new Vector3().setFromMatrixColumn(camera.matrix, 0);
    const up = new Vector3().setFromMatrixColumn(camera.matrix, 1);
    const target = new Vector3(base.target.x, base.target.y, base.target.z);
    const distance = camera.position.distanceTo(target);
    const offset = right
      .multiplyScalar((motion.x * distance) / 30)
      .add(up.multiplyScalar((motion.y * distance) / 40));
    camera.position.sub(target).divideScalar(motion.scale).add(target).add(offset);
    camera.lookAt(target.add(offset));
  } else {
    camera.position.set(
      frame.target.x + shift + (motion.x * frame.distance) / 30,
      frame.target.y + 0.1 + (motion.y * frame.distance) / 40,
      frame.target.z + frame.distance / motion.scale,
    );
    camera.lookAt(
      frame.target.x + shift + (motion.x * frame.distance) / 30,
      frame.target.y + (motion.y * frame.distance) / 40,
      frame.target.z,
    );
  }
  camera.rotateZ((motion.rotation * Math.PI) / 180);
  camera.rotateY((motion.tilt * Math.PI) / 180);
  camera.updateProjectionMatrix();
  camera.updateMatrixWorld();
}
