import { useEffect, useRef, useState } from "react";
import type { Scene3D } from "../../contracts/scene3d.ts";
import type { ModelSource } from "./models.ts";
import { createScene } from "./render.ts";

const thumbnails = new Map<string, string>();
let queue = Promise.resolve();
function thumbnail(source: ModelSource) {
  return new Promise<string>((resolve, reject) => {
    queue = queue
      .then(async () => {
        const cached = thumbnails.get(source.id);
        if (cached) {
          resolve(cached);
          return;
        }
        const canvas = document.createElement("canvas");
        const scene: Scene3D = {
          version: 1,
          title: source.title.slice(0, 100),
          style: "toon",
          elements: [{ assetId: source.id, layer: "main" }],
          position: "center",
          shot: "medium",
          ambience: "daylight",
          particles: "none",
          blend: false,
          cinematic: {
            preset: "none",
            speed: "normal",
            intensity: "subtle",
            direction: "auto",
            atmosphere: "none",
            layers: [],
          },
        };
        const previewSource = {
          ...source,
          model3d: { ...source.model3d, roles: [...source.model3d.roles, "main" as const] },
        };
        const surface = await createScene(
          canvas,
          scene,
          [previewSource],
          new AbortController().signal,
          true,
        );
        try {
          const small = document.createElement("canvas");
          small.width = 140;
          small.height = 170;
          small.getContext("2d")!.drawImage(canvas, 0, 0, small.width, small.height);
          const url = small.toDataURL("image/webp", 0.8);
          thumbnails.set(source.id, url);
          resolve(url);
        } finally {
          surface.dispose();
        }
      })
      .catch(reject);
  });
}
function ModelThumbnail({ source }: { source: ModelSource }) {
  const [url, setUrl] = useState(thumbnails.get(source.id) ?? "");
  const node = useRef<HTMLSpanElement>(null);
  const sourceKey = JSON.stringify(source);
  useEffect(() => {
    let active = true;
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      void thumbnail(JSON.parse(sourceKey))
        .then((url) => {
          if (active) setUrl(url);
        })
        .catch(() => {});
    });
    observer.observe(node.current!);
    return () => {
      active = false;
      observer.disconnect();
    };
  }, [sourceKey]);
  return (
    <span className="model-thumbnail" ref={node}>
      {url ? <img src={url} alt="" /> : <span aria-hidden="true">◇</span>}
    </span>
  );
}
export function Gallery({
  sources,
  layer,
  onLayer,
  onAdd,
}: {
  sources: ModelSource[];
  layer: Scene3D["elements"][number]["layer"];
  onLayer: (layer: Scene3D["elements"][number]["layer"]) => void;
  onAdd: (source: ModelSource) => void;
}) {
  const [search, setSearch] = useState("");
  const [selection, setSelection] = useState({ value: "all", layer });
  const category = selection.layer === layer ? selection.value : "all";
  const setCategory = (value: string, nextLayer = layer) =>
    setSelection({ value, layer: nextLayer });
  const categories = {
    all: "All",
    character: "Characters",
    object: "Props",
    nature: "Trees & nature",
    architecture: "Architecture",
    environment: "Backgrounds",
  };
  const filtered = sources.filter(
    (source) =>
      source.model3d.roles.includes(layer) &&
      (category === "all" ||
        (category === "environment"
          ? source.model3d.roles.includes("background")
          : category === "object"
            ? ["object", "nature"].includes(source.model3d.category)
            : source.model3d.category === category)) &&
      `${source.title} ${source.model3d.category}`.toLowerCase().includes(search.toLowerCase()),
  );
  return (
    <section className="scene3d-gallery" aria-label="Asset gallery">
      <header>
        <strong>Gallery</strong>
        <input
          aria-label="Search 3D assets"
          type="search"
          placeholder="Search assets…"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />
      </header>
      <label className="gallery-target">
        Add to
        <select
          aria-label="Gallery layer"
          value={layer}
          onChange={(e) => {
            onLayer(e.target.value as typeof layer);
            setCategory("all");
          }}
        >
          {["main", "foreground", "midground", "background"].map((value) => (
            <option key={value} value={value}>
              {value === "main" ? "Main subject" : value}
            </option>
          ))}
        </select>
      </label>
      <p className="gallery-depth-help">
        Foreground frames the page. Middleground carries the scene. Background adds distance.
        Subjects are optional.
      </p>
      <div className="gallery-browser">
        <nav aria-label="Asset categories">
          {Object.entries(categories).map(([value, label]) => (
            <button
              type="button"
              key={value}
              aria-pressed={category === value}
              onClick={() => {
                const nextLayer =
                  value === "character"
                    ? "main"
                    : value === "environment"
                      ? "background"
                      : ["object", "nature"].includes(value) && layer === "main"
                        ? "foreground"
                        : value === "architecture" && layer === "main"
                          ? "midground"
                          : layer;
                setCategory(value, nextLayer);
                onLayer(nextLayer);
              }}
            >
              {label}
            </button>
          ))}
        </nav>
        <div className="model-grid">
          {filtered.slice(0, 24).map((source) => (
            <button
              type="button"
              key={source.id}
              title={`Add ${source.title} to ${layer}`}
              aria-label={`Add ${source.title} to ${layer}`}
              onClick={() => onAdd(source)}
            >
              <ModelThumbnail source={source} />
              <span>{source.title}</span>
            </button>
          ))}
          {!filtered.length && <p>No compatible assets. Change the layer or import a GLB.</p>}
        </div>
      </div>
    </section>
  );
}
