import { commitSceneCamera, appendSceneModel, replaceSceneElement } from "./composition.ts";
import { expect, it } from "vitest";
import { Box3, BoxGeometry, Mesh, MeshBasicMaterial, Vector3, PerspectiveCamera } from "three";
import { placeModel, avoidOverlap, cameraFraming, animateCamera } from "./composition.ts";
import { Scene3DSchema } from "../../contracts/scene3d.ts";
import { removeSceneElement } from "./composition.ts";
import { sceneTemplate } from "./templates.ts";
import { CinematicSchema } from "../../contracts/cinematic.ts";
import { sceneFocus } from "./composition.ts";

it("normalizes tiny objects, separates architecture anchors, and frames portrait shots", () => {
  const root = new Mesh(new BoxGeometry(0.01, 0.01, 0.01), new MeshBasicMaterial());
  const metadata = {
    category: "object" as const,
    roles: ["main" as const],
    dimensions: { x: 0.01, y: 0.01, z: 0.01 },
    animations: [],
  };
  const box = placeModel(root, metadata, "main", 0);
  expect(box.getSize(new Vector3()).y).toBeCloseTo(0.9);
  expect(box.min.y).toBeCloseTo(0);
  const placed: Box3[] = [];
  avoidOverlap(box, placed);
  expect(() => avoidOverlap(box.clone(), placed)).toThrow(/overlap/);
  expect(cameraFraming(box, 0.5, "wide").distance).toBeGreaterThan(
    cameraFraming(box, 1.8, "wide").distance,
  );
  root.geometry.dispose();
  root.material.dispose();
});
it("moves a real camera so foreground displacement exceeds distant geometry", () => {
  const scene = Scene3DSchema.parse({
    version: 1,
    title: "Courtyard",
    style: "toon",
    elements: [{ assetId: "knight", layer: "main" }],
    position: "center",
    shot: "wide",
    ambience: "mist",
    particles: "none",
    blend: true,
    cinematic: { preset: "parallax", intensity: "normal", direction: "right" },
  });
  const camera = new PerspectiveCamera(45, 1.6, 0.1, 300);
  const frame = { target: new Vector3(0, 1, 0), distance: 6 };
  animateCamera(camera, scene, frame, 0);
  const front = new Vector3(-1, 1, 2).project(camera).x,
    back = new Vector3(-1, 1, -12).project(camera).x;
  animateCamera(camera, scene, frame, 1);
  const frontMovement = Math.abs(new Vector3(-1, 1, 2).project(camera).x - front);
  const backMovement = Math.abs(new Vector3(-1, 1, -12).project(camera).x - back);
  expect(frontMovement).toBeGreaterThan(backMovement * 2);
  animateCamera(
    camera,
    { ...scene, position: "left", cinematic: { ...scene.cinematic, preset: "none" } },
    frame,
    0,
  );
  expect(frame.target.clone().project(camera).x).toBeLessThan(0);
  animateCamera(
    camera,
    { ...scene, position: "right", cinematic: { ...scene.cinematic, preset: "none" } },
    frame,
    0,
  );
  expect(frame.target.clone().project(camera).x).toBeGreaterThan(0);
});

it("retains a manual camera and object pose without mutating previous compositions", () => {
  const scene = Scene3DSchema.parse({
    version: 1,
    title: "Shot",
    style: "rim",
    elements: [{ assetId: "knight", layer: "main" }],
    position: "center",
    shot: "medium",
    ambience: "mist",
    particles: "none",
    blend: true,
    cinematic: { preset: "none" },
  });
  const camera = { position: { x: 3, y: 2, z: 6 }, target: { x: 0, y: 1, z: 0 }, fov: 38 };
  const transform = {
    position: { x: 0.6, y: 0, z: 0 },
    rotation: { x: 0, y: 20, z: 0 },
    scale: 1.1,
  };
  const next = commitSceneCamera(scene, camera, transform, 0);
  expect(scene.camera).toBeUndefined();
  expect(scene.elements[0]!.transform).toBeUndefined();
  expect(next.elements[0]!.transform).toEqual(transform);
  const actual = new PerspectiveCamera(45, 1.6, 0.1, 300);
  animateCamera(actual, next, { target: new Vector3(0, 1, 0), distance: 6 }, 0);
  expect(actual.position.toArray()).toEqual([3, 2, 6]);
  expect(actual.fov).toBe(38);
  const pair = appendSceneModel(next, "other", "main");
  expect(() => appendSceneModel(pair, "third", "main")).toThrow(/slots/);
  expect(replaceSceneElement(pair, 99, pair.elements[0]!)).toBe(pair);
});

it("keeps scenery in place when a model is removed and reuses the vacated anchor", () => {
  const scene = sceneTemplate("village", CinematicSchema.parse({ preset: "none" }));
  const gateIndex = scene.elements.findIndex((element) =>
    element.assetId.endsWith("castle-wall-gate-01"),
  );
  const gate = scene.elements[gateIndex]!;
  const positions = (value: typeof scene) =>
    value.elements
      .filter((e) => e.layer === "background")
      .map((element, index) => {
        const mesh = new Mesh(new BoxGeometry(1, 1, 1), new MeshBasicMaterial());
        const box = placeModel(
          mesh,
          {
            category: "architecture",
            roles: ["background"],
            dimensions: { x: 1, y: 1, z: 1 },
            animations: [],
          },
          "background",
          index,
        );
        const center = box
          .getCenter(new Vector3())
          .add(element.transform?.position ?? { x: 0, y: 0, z: 0 });
        mesh.geometry.dispose();
        mesh.material.dispose();
        return center.toArray();
      });
  const before = positions(scene);
  const without = removeSceneElement(scene, gateIndex);
  expect(positions(without)).toEqual(before.slice(1));
  expect(scene.elements).toHaveLength(10);
  const replaced = appendSceneModel(without, gate.assetId, "background");
  expect(positions(replaced)).toEqual([...before.slice(1), before[0]]);
  expect(removeSceneElement(scene, 99)).toBe(scene);
});

it("frames a place using its visible scenery without foreground props pulling the camera away", () => {
  const scenery = new Mesh(new BoxGeometry(8, 5, 2), new MeshBasicMaterial());
  scenery.position.set(2, 2.5, -10);
  const front = new Mesh(new BoxGeometry(2, 2, 2), new MeshBasicMaterial());
  front.position.set(-20, 0, 3);
  const focus = sceneFocus(
    [scenery, front],
    [
      { assetId: "castle", layer: "background" },
      { assetId: "tree", layer: "foreground" },
    ],
  );
  expect(focus.subjects).toHaveLength(0);
  expect(focus.bounds.getCenter(new Vector3()).toArray()).toEqual([2, 2.5, -10]);
  expect(cameraFraming(focus.bounds, 1.4, "wide").distance).toBeGreaterThan(0);
  scenery.geometry.dispose();
  scenery.material.dispose();
  front.geometry.dispose();
  front.material.dispose();
});
