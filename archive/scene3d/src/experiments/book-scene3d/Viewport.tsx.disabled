import type { RefObject } from "react";
import type { Tool } from "./controls.ts";
const tools: Record<string, Tool> = {
  w: "translate",
  e: "rotate",
  r: "scale",
  c: "camera",
  p: "pan",
};
const labels = { translate: "Move", rotate: "Rotate", scale: "Scale", camera: "Orbit", pan: "Pan" };
const help = {
  translate: "Move selected object (W)",
  rotate: "Rotate selected object (E)",
  scale: "Scale selected object (R)",
  camera: "Orbit camera: drag to rotate, right-drag to pan, scroll to zoom (C)",
  pan: "Pan the camera (P)",
};
export function Viewport({
  canvas,
  canvasKey,
  ready,
  tool,
  onTool,
  onFrame,
}: {
  canvas: RefObject<HTMLCanvasElement | null>;
  canvasKey: string;
  ready: boolean;
  tool: Tool;
  onTool: (tool: Tool) => void;
  onFrame: () => void;
}) {
  return (
    <>
      <div className="composition-viewport">
        <canvas
          ref={canvas}
          key={canvasKey}
          tabIndex={0}
          aria-label="Live 3D composition preview"
          data-ready={ready}
          onKeyDown={(event) => {
            if (event.ctrlKey || event.metaKey || event.altKey) return;
            const next = tools[event.key.toLowerCase()];
            if (next) {
              event.preventDefault();
              onTool(next);
            }
          }}
        />
        <div className="viewport-tools" role="toolbar" aria-label="3D viewport tools">
          {(Object.keys(labels) as Tool[]).map((value) => (
            <button
              type="button"
              key={value}
              aria-pressed={tool === value}
              title={help[value]}
              onClick={() => onTool(value)}
            >
              {labels[value]}
            </button>
          ))}
          <button type="button" title="Restore automatic camera framing" onClick={onFrame}>
            Reframe
          </button>
        </div>
      </div>
      <p className="viewport-help">
        Drag to orbit · right-drag to pan · scroll to zoom. Select a layer or click an object to
        transform it.
      </p>
    </>
  );
}
