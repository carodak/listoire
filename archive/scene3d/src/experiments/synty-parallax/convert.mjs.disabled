// Local, disposable conversion. Reads the owned pack; exports only this scene's selected geometry.
import { readFile, writeFile, mkdir } from "node:fs/promises";
import { FBXLoader } from "three/addons/loaders/FBXLoader.js";
import { GLTFExporter } from "three/addons/exporters/GLTFExporter.js";
import {
  Box3,
  Vector3,
  Quaternion,
  Mesh,
  MeshStandardMaterial,
  Group,
  SphereGeometry,
} from "three";
import { InkNarrativeEngine } from "../../features/story-runtime/ink-engine.ts";
import { BundleSchema } from "../../contracts/story.ts";

globalThis.document = {
  createElementNS() {
    return { addEventListener() {}, removeEventListener() {}, set src(value) {} };
  },
};
globalThis.window = { innerWidth: 1200, innerHeight: 900 };
globalThis.FileReader = class {
  async readAsArrayBuffer(blob) {
    this.result = await blob.arrayBuffer();
    this.onloadend?.();
  }
};
const source = new URL("../../../assets/Synty/PolygonKnights/", import.meta.url);
const output = new URL("./assets/", import.meta.url);
await mkdir(output, { recursive: true });
const models = [
  "SM_Bld_Castle_Wall_Gate_01",
  "SM_Bld_Castle_Tower_01",
  "SM_Bld_Castle_Tower_Top_01",
  "SM_Bld_Castle_Wall_01",
  "SM_Bld_House_Room_01",
  "SM_Bld_House_RoomTop_01",
  "SM_Bld_Castle_Pillar_01",
  "SM_Env_Path_Cobble_01",
  "SM_Env_Tree_01",
  "SM_Env_RockPile_01",
  "SM_Env_MountainGrass_01",
];
const characterOnly = process.argv.includes("--character-only");
const report = characterOnly
  ? JSON.parse(await readFile(new URL("conversion.json", output), "utf8")).filter(
      (entry) => entry.model !== "soldier.glb",
    )
  : [];

function headwearVertices(geometry) {
  const positions = geometry.getAttribute("position"),
    linked = new Map(),
    keys = [];
  let highest = 0;
  for (let at = 0; at < positions.count; at++) {
    const key = [positions.getX(at), positions.getY(at), positions.getZ(at)]
      .map((value) => value.toFixed(3))
      .join(",");
    keys.push(key);
    const triangles = linked.get(key) ?? [];
    triangles.push(Math.floor(at / 3));
    linked.set(key, triangles);
    if (positions.getY(at) > positions.getY(highest)) highest = at;
  }
  const pending = [Math.floor(highest / 3)],
    triangles = new Set();
  while (pending.length) {
    const triangle = pending.pop();
    if (triangles.has(triangle)) continue;
    triangles.add(triangle);
    for (let corner = 0; corner < 3; corner++)
      pending.push(...linked.get(keys[triangle * 3 + corner]));
  }
  const removed = new Set(
    [...triangles].flatMap((triangle) => [triangle * 3, triangle * 3 + 1, triangle * 3 + 2]),
  );
  if (removed.size !== 309 || [...removed].some((at) => positions.getY(at) < 156))
    throw new Error("Soldier headwear changed; inspect the source before removing geometry.");
  return removed;
}
const poseArm = (root, side, direction) => {
  const shoulder = root.getObjectByName(`Shoulder_${side}`);
  const elbow = root.getObjectByName(`Elbow_${side}`);
  const from = elbow
    .getWorldPosition(new Vector3())
    .sub(shoulder.getWorldPosition(new Vector3()))
    .normalize();
  const delta = new Quaternion().setFromUnitVectors(
    from,
    new Vector3(direction * 0.2, -0.97, 0.12).normalize(),
  );
  const rotation = delta.multiply(shoulder.getWorldQuaternion(new Quaternion()));
  shoulder.quaternion.copy(
    shoulder.parent.getWorldQuaternion(new Quaternion()).invert().multiply(rotation),
  );
  root.updateMatrixWorld(true);
};
function isEyeOrBrow(node, geometry, at) {
  const weights = geometry.getAttribute("skinWeight"),
    bones = geometry.getAttribute("skinIndex");
  for (let influence = 0; influence < 4; influence++)
    if (
      weights.getComponent(at, influence) > 0.2 &&
      /^(Eyes|Eyebrows)$/.test(node.skeleton.bones[bones.getComponent(at, influence)].name)
    )
      return true;
  return false;
}
function removeFacialFeatures(geometry, node) {
  if (geometry.index) throw new Error("Expected the pack's non-indexed facial geometry");
  const uv = geometry.getAttribute("uv"),
    positions = geometry.getAttribute("position");
  const removed = headwearVertices(geometry);
  let changed = 0;
  for (let at = 0; at < uv.count; at++) {
    const eyeOrBrow = isEyeOrBrow(node, geometry, at);
    const mouthMark =
      positions.getY(at) > 145 && positions.getZ(at) > 8 && uv.getX(at) < 0.1 && uv.getY(at) < 0.12;
    if (eyeOrBrow) removed.add(at);
    if (eyeOrBrow || mouthMark) {
      uv.setXY(at, 0.34, 0.935);
      changed++;
    }
  }
  if (!changed || !removed.size) throw new Error("No facial markings selected");
  const kept = [];
  for (let at = 0; at < uv.count; at += 3)
    if (![at, at + 1, at + 2].some((vertex) => removed.has(vertex))) kept.push(at, at + 1, at + 2);
  geometry.setIndex(kept);
}
function bakePose(geometry, node) {
  const position = geometry.getAttribute("position"),
    vertex = new Vector3();
  for (let at = 0; at < position.count; at++) {
    vertex.fromBufferAttribute(position, at);
    node.applyBoneTransform(at, vertex);
    position.setXYZ(at, vertex.x, vertex.y, vertex.z);
  }
  geometry.deleteAttribute("skinIndex");
  geometry.deleteAttribute("skinWeight");
  geometry.computeVertexNormals();
}
for (const name of [...(characterOnly ? [] : models), "Characters/Characters"]) {
  const bytes = await readFile(new URL(`Models/${name}.fbx`, source));
  const root = new FBXLoader().parse(
    bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength),
    "",
  );
  root.updateMatrixWorld(true);
  if (name.startsWith("Characters/")) {
    poseArm(root, "L", 1);
    poseArm(root, "R", -1);
    root.traverse((node) => {
      if (node.isSkinnedMesh) node.skeleton.update();
    });
  }
  const group = new Group();
  root.traverse((node) => {
    if (!node.isMesh || (name.startsWith("Characters/") && node.name !== "Character_Soldier_01"))
      return;
    const geometry = node.geometry.clone();
    if (node.isSkinnedMesh) {
      removeFacialFeatures(geometry, node);
      bakePose(geometry, node);
    }
    geometry.applyMatrix4(node.matrixWorld);
    geometry.normalizeNormals();
    const mesh = new Mesh(
      node.isSkinnedMesh ? geometry.toNonIndexed() : geometry,
      new MeshStandardMaterial(),
    );
    mesh.name = node.name;
    group.add(mesh);
    if (node.isSkinnedMesh) {
      // The source omits the scalp hidden by the helmet; close it behind the original face.
      const scalp = new SphereGeometry(1, 10, 8);
      scalp.scale(10.5, 16.5, 12);
      scalp.translate(0, 166, -1.5);
      scalp.applyMatrix4(node.matrixWorld);
      const uv = scalp.getAttribute("uv");
      for (let at = 0; at < uv.count; at++) uv.setXY(at, 0.34, 0.935);
      const head = new Mesh(scalp, new MeshStandardMaterial());
      head.name = "Soldier_Bare_Scalp";
      group.add(head);
    }
  });
  const bounds = new Box3().setFromObject(group);
  group.scale.setScalar(0.01);
  const target = name.startsWith("Characters/") ? "soldier" : name;
  const glb = await new GLTFExporter().parseAsync(group, { binary: true, onlyVisible: true });
  await writeFile(new URL(`${target}.glb`, output), new Uint8Array(glb));
  report.push({
    source: `assets/Synty/PolygonKnights/Models/${name}.fbx`,
    model: `${target}.glb`,
    bounds: { min: bounds.min.toArray(), max: bounds.max.toArray() },
    ...(name.startsWith("Characters/") ? { headwearTrianglesRemoved: 103, bareScalp: true } : {}),
  });
}
if (!characterOnly)
  for (const [from, to] of [
    ["PolygonKnights_01.png", "environment.png"],
    ["Characters_01_Black.png", "character.png"],
  ])
    await writeFile(new URL(to, output), await readFile(new URL(`Textures/${from}`, source)));
await writeFile(new URL("conversion.json", output), JSON.stringify(report, null, 2) + "\n");
console.log(`Converted ${characterOnly ? 1 : report.length} selected Synty models.`);
if (!characterOnly) {
  const bundle = BundleSchema.parse(
    JSON.parse(
      await readFile(new URL("../../../public/stories/house/en.json", import.meta.url), "utf8"),
    ),
  );
  const frame = new InkNarrativeEngine(bundle).advance();
  await writeFile(
    new URL("excerpt.json", import.meta.url),
    JSON.stringify(
      {
        title: bundle.title,
        heading: bundle.scenes.intro.title,
        paragraphs: frame.segments.map((segment) => segment.text),
      },
      null,
      2,
    ) + "\n",
  );
}
