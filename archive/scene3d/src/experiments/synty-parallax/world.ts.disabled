import { Box3, Vector3, Group, Mesh, PlaneGeometry } from "three";
import type { Material } from "three";

export function buildCourtyard(models: Record<string, Group>, material: Material) {
  const world = new Group();
  const place = (name: string, x: number, y: number, z: number, scale = 1, rotation = 0) => {
    const model = models[name]!.clone(true);
    const bounds = new Box3().setFromObject(model),
      center = bounds.getCenter(new Vector3());
    model.position.set(-center.x, -bounds.min.y, -center.z);
    const instance = new Group();
    instance.add(model);
    instance.position.set(x, y, z);
    instance.scale.setScalar(scale);
    instance.rotation.y = rotation;
    world.add(instance);
    return instance;
  };
  const ground = new Mesh(new PlaneGeometry(160, 160), material);
  ground.rotation.x = -Math.PI / 2;
  ground.position.y = -0.08;
  ground.userData.surface = "ground";
  world.add(ground);
  for (let x = -9; x <= 9; x += 3)
    for (let z = -21; z <= 9; z += 3) place("SM_Env_Path_Cobble_01", x, 0, z);
  place("SM_Bld_Castle_Wall_Gate_01", 0, 0, -13, 1.65);
  for (const side of [-1, 1]) {
    place("SM_Bld_Castle_Tower_01", side * 6.5, 0, -13, 2.6);
    place("SM_Bld_Castle_Tower_Top_01", side * 6.5, 7.9, -13, 2.6);
    place("SM_Bld_Castle_Wall_01", side * 12, 0, -13, 1.65);
    for (const z of [-5, -15, -24]) {
      place("SM_Bld_House_Room_01", side * 7.5, 0, z, 0.9, (side * Math.PI) / 2);
      place("SM_Bld_House_RoomTop_01", side * 7.5, 4.58, z, 0.9, (side * Math.PI) / 2);
    }
    for (const z of [-24, -34, -44]) place("SM_Env_Tree_01", side * 11, 0, z, 3.2);
  }
  place("SM_Env_MountainGrass_01", 0, -1, -70, 6);
  place("SM_Bld_Castle_Tower_01", 0, 0, -39, 3.7);
  place("SM_Bld_Castle_Tower_Top_01", 0, 11.2, -39, 3.7);
  place("SM_Bld_Castle_Pillar_01", -3.4, 0, 5.2, 1.4);
  place("SM_Bld_Castle_Pillar_01", 6.8, 0, 3.8, 1.4);
  place("SM_Env_Tree_01", -5, 0, 3, 2.1);
  place("SM_Env_Tree_01", 11, 0, 4, 2);
  place("SM_Env_RockPile_01", -2.8, 0, 7.1, 0.24);
  place("SM_Env_RockPile_01", 5, 0, -1, 0.3);
  const character = place("soldier", 0.1, 0.03, -0.8, 1.45, 0.3);
  character.traverse((node) => {
    node.userData.surface = "character";
  });
  world.traverse((node) => {
    if (node instanceof Mesh) {
      node.castShadow = true;
      node.receiveShadow = true;
    }
  });
  return world;
}
