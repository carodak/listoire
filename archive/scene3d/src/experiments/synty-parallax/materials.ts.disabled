import { brushFunctions, surfaceShaders } from "./surface-shaders.ts";
import type { Scene3D } from "../../contracts/scene3d.ts";
import {
  DataTexture,
  RedFormat,
  NearestFilter,
  LinearFilter,
  MeshToonMaterial,
  MeshStandardMaterial,
  Color,
  MeshPhongMaterial,
} from "three";
import type { Texture } from "three";

export type Style = "toon" | "painterly";
export function illustrationMaterial(
  style: Scene3D["style"],
  map: Texture | null,
  color = "#ffffff",
) {
  const values =
    style === "gradient"
      ? Uint8Array.from({ length: 64 }, (_, index) => 40 + (index * 215) / 63)
      : new Uint8Array([48, 48, 160, 255]);
  const ramp = new DataTexture(values, values.length, 1, RedFormat);
  ramp.minFilter = ramp.magFilter = style === "gradient" ? LinearFilter : NearestFilter;
  ramp.needsUpdate = true;
  const material =
    style === "glossy"
      ? new MeshPhongMaterial({ map, color, shininess: 100, specular: new Color("#cbd5e4") })
      : style === "painterly"
        ? new MeshStandardMaterial({ map, color, roughness: 0.95, metalness: 0 })
        : new MeshToonMaterial({ map, color, gradientMap: ramp });
  material.addEventListener("dispose", () => ramp.dispose());
  material.onBeforeCompile = (shader) => {
    shader.vertexShader = shader.vertexShader
      .replace("#include <common>", "#include <common>\nvarying vec3 vBrushPosition;")
      .replace(
        "#include <project_vertex>",
        "vBrushPosition = (modelMatrix * vec4(transformed, 1.0)).xyz;\n#include <project_vertex>",
      );
    shader.fragmentShader = shader.fragmentShader
      .replace("#include <common>", `#include <common>\n${brushFunctions}`)
      .replace(
        "#include <color_fragment>",
        `#include <color_fragment>
        float inkLuma = dot(diffuseColor.rgb,vec3(0.2126,0.7152,0.0722));
        diffuseColor.rgb = mix(vec3(inkLuma),diffuseColor.rgb,0.9);`,
      )
      .replace(
        "#include <opaque_fragment>",
        `${surfaceShaders[style]}\n#include <opaque_fragment>`,
      );
  };
  material.customProgramCacheKey = () => `illustration-${style}`;
  return material;
}
export function illustrationMaterials(environment: Texture, character: Texture) {
  const make = illustrationMaterial;
  const group = (style: Style) => ({
    environment: make(style, environment),
    character: make(style, character),
    ground: make(style, null, new Color("#62634e").getStyle()),
  });
  const styles = { toon: group("toon"), painterly: group("painterly") };
  return {
    styles,
    dispose() {
      Object.values(styles).forEach((group) =>
        Object.values(group).forEach((material) => material.dispose()),
      );
    },
  };
}
