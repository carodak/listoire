import { useEffect, useRef, useState } from "react";
import { createSyntyScene } from "./scene.ts";
import type { Style } from "./materials.ts";
import excerpt from "./excerpt.json";
import "./experiment.css";

export default function SyntyParallax() {
  const canvas = useRef<HTMLCanvasElement>(null);
  const control = useRef<Awaited<ReturnType<typeof createSyntyScene>> | null>(null);
  const [status, setStatus] = useState("Loading the courtyard…");
  const [style, setStyle] = useState<Style>("toon");
  const [progress, setProgress] = useState(0);
  const [ready, setReady] = useState(false);
  useEffect(() => {
    const scope = new AbortController();
    void createSyntyScene(canvas.current!, scope.signal, setProgress)
      .then((scene) => {
        if (scope.signal.aborted) return scene.dispose();
        control.current = scene;
        setReady(true);
        setStatus("");
      })
      .catch((error: unknown) => {
        if (!scope.signal.aborted)
          setStatus(
            error instanceof Error ? error.message : "WebGL is unavailable in this browser.",
          );
      });
    return () => {
      scope.abort();
      control.current?.dispose();
      control.current = null;
    };
  }, []);
  return (
    <main className="synty-experiment">
      <header className="synty-toolbar">
        <a href="/editor">← Story Editor</a>
        <span>Synty · The silent courtyard</span>
        <div aria-label="Artistic style">
          {(["toon", "painterly"] as const).map((mode) => (
            <button
              key={mode}
              disabled={!ready}
              aria-pressed={style === mode}
              onClick={() => {
                setStyle(mode);
                control.current?.setStyle(mode);
              }}
            >
              {mode === "toon" ? "Toon" : "Painterly"}
            </button>
          ))}
        </div>
      </header>
      <div className="synty-book">
        <article className="synty-novel">
          <p className="synty-eyebrow">{excerpt.title}</p>
          <h1>{excerpt.heading}</h1>
          <span className="synty-rule" aria-hidden="true" />
          {excerpt.paragraphs.map((text, index) => (
            <p className="synty-paragraph" key={index}>
              {text}
            </p>
          ))}
        </article>
        <section
          className="synty-illustration"
          aria-label="A faceless knight in a medieval courtyard"
        >
          <canvas ref={canvas} aria-label="Synty medieval courtyard, rendered in 3D" />
          {status && (
            <p className="synty-status" role="status">
              {status}
            </p>
          )}
          <div className="synty-playback">
            <button
              disabled={!ready}
              onClick={() => {
                setProgress(0);
                control.current?.play();
              }}
            >
              ▷ {progress > 0 ? "Replay" : "Play"}
            </button>
            <progress aria-label="Cinematic movement" value={progress} max={1} />
            <span>{(progress * 6).toFixed(1)} / 6 s</span>
          </div>
        </section>
      </div>
    </main>
  );
}
