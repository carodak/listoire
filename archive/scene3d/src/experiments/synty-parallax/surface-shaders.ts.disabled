export const brushFunctions = /* glsl */ `
varying vec3 vBrushPosition;
float brushHash(vec2 p) { return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453); }
float brushNoise(vec2 p) {
  vec2 cell = floor(p), f = fract(p); f = f*f*(3.0-2.0*f);
  return mix(mix(brushHash(cell),brushHash(cell+vec2(1,0)),f.x),mix(brushHash(cell+vec2(0,1)),brushHash(cell+vec2(1,1)),f.x),f.y);
}
float pencilStroke(vec2 p, float angle, float spacing) {
  vec2 axis = vec2(cos(angle),sin(angle));
  float wave = dot(p,axis)/spacing + brushNoise(p*0.025)*0.45;
  float line = abs(fract(wave)-0.5);
  return 1.0-smoothstep(0.035,0.18,line);
}
`;

export const surfaceShaders = {
  toon: /* glsl */ `
    float light = dot(outgoingLight,vec3(0.2126,0.7152,0.0722)) / max(dot(diffuseColor.rgb,vec3(0.2126,0.7152,0.0722)),0.04);
    vec3 shade = diffuseColor.rgb * vec3(0.21,0.24,0.37);
    vec3 mid = diffuseColor.rgb * 0.95;
    vec3 lit = diffuseColor.rgb * vec3(1.55,1.48,1.25);
    outgoingLight = mix(shade,mid,step(0.38,light));
    outgoingLight = mix(outgoingLight,lit,step(1.15,light));
  `,
  painterly: /* glsl */ `
    vec2 brush = vBrushPosition.xy * vec2(18.0,32.0) + vBrushPosition.z * vec2(9.0,5.0);
    float patches = brushNoise(brush + vec2(brushNoise(brush*0.4)*3.0));
    float bristles = brushNoise(brush*vec2(0.7,9.0));
    float light = dot(outgoingLight,vec3(0.2126,0.7152,0.0722)) / max(dot(diffuseColor.rgb,vec3(0.2126,0.7152,0.0722)),0.04);
    float paint = floor(clamp(light*0.55 + (patches-0.5)*0.2,0.0,1.0)*5.0)/5.0;
    vec3 pigment = diffuseColor.rgb * mix(vec3(0.30,0.39,0.53),vec3(1.65,1.44,1.11),paint);
    outgoingLight = mix(outgoingLight,pigment,0.85) * (0.91+patches*0.14+bristles*0.06);
  `,
  sketch: /* glsl */ `
    float pigment = dot(diffuseColor.rgb,vec3(0.2126,0.7152,0.0722));
    float light = dot(outgoingLight,vec3(0.2126,0.7152,0.0722)) / max(pigment,0.04);
    float shadow = clamp((1.0-smoothstep(0.35,1.35,light))*0.65 + (1.0-smoothstep(0.02,0.3,pigment))*0.6,0.0,1.0);
    vec2 paperUV = gl_FragCoord.xy;
    float grain = brushNoise(paperUV*0.7);
    float hatchA = pencilStroke(paperUV,0.8,4.8);
    float hatchB = pencilStroke(paperUV,-0.65,5.8);
    float graphite = shadow*0.28 + hatchA*shadow*0.46 + hatchB*smoothstep(0.35,0.9,shadow)*0.36;
    graphite += (grain-0.5)*0.10*shadow;
    outgoingLight = mix(vec3(1.0,0.98,0.92)*(0.96+grain*0.04),vec3(0.028,0.032,0.038),clamp(graphite,0.0,0.94));
  `,
  "sketch-color": /* glsl */ `
    float light = dot(outgoingLight,vec3(0.2126,0.7152,0.0722)) / max(dot(diffuseColor.rgb,vec3(0.2126,0.7152,0.0722)),0.04);
    float shadow = 1.0-smoothstep(0.35,0.85,light);
    float hatch = pencilStroke(gl_FragCoord.xy,0.72,7.0);
    float paper = brushNoise(gl_FragCoord.xy*0.8);
    outgoingLight = mix(outgoingLight,diffuseColor.rgb*(0.5+step(0.8,light)*0.65),0.6);
    outgoingLight *= (0.98+paper*0.03)*(1.0-hatch*shadow*0.12);
  `,
  gradient:
    "float shade = clamp(dot(outgoingLight,vec3(0.2126,0.7152,0.0722)),0.0,1.0); outgoingLight = diffuseColor.rgb * mix(vec3(0.13,0.22,0.40),vec3(1.22,1.05,0.75),smoothstep(0.0,0.8,shade));",
  poster:
    "float luminance = max(dot(outgoingLight,vec3(0.2126,0.7152,0.0722)),0.001); float band = max(0.03,floor(luminance*6.0+0.5)/6.0); outgoingLight *= band/luminance;",
  rim: "float rim = pow(1.0 - abs(dot(normal,normalize(vViewPosition))),3.0); outgoingLight += vec3(0.72,0.90,1.0) * rim * 0.65;",
  halftone:
    "vec2 cell = fract(gl_FragCoord.xy / 6.0)-0.5; float lum = clamp(dot(outgoingLight,vec3(0.2126,0.7152,0.0722)),0.0,1.0); float dots = 1.0-smoothstep(0.08,0.18,length(cell)-sqrt(1.0-lum)*0.36); outgoingLight *= mix(1.0,0.2,dots);",
  hatching:
    "float shadow = 1.0-clamp(dot(outgoingLight,vec3(0.2126,0.7152,0.0722))*1.4,0.0,1.0); float hatchA = pencilStroke(gl_FragCoord.xy,0.8,4.8); float hatchB = pencilStroke(gl_FragCoord.xy,-0.65,5.8); outgoingLight *= 1.0-shadow*(hatchA*0.5+hatchB*0.3);",
  glossy:
    "float rim = pow(1.0-abs(dot(normal,normalize(vViewPosition))),4.0); outgoingLight += vec3(0.6,0.75,0.85)*rim*0.25;",
};
