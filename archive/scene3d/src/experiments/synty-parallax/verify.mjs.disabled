import { chromium } from "playwright";
import assert from "node:assert/strict";
const browser = await chromium.launch({ args: ["--enable-unsafe-swiftshader"] });
try {
  const page = await browser.newPage({ viewport: { width: 1600, height: 1000 } });
  const errors = [];
  page.on("pageerror", (error) => errors.push(error.message));
  page.on("console", (message) => {
    if (message.type() === "error") errors.push(message.text());
  });
  await page.goto("http://127.0.0.1:4173/editor?experiment=synty-parallax");
  await page.getByRole("button", { name: "▷ Play", exact: true }).waitFor({ timeout: 45000 });
  await page.waitForFunction(() => !document.querySelector(".synty-playback button")?.disabled, {
    timeout: 45000,
  });
  await page.screenshot({ path: ".fallow/synty-toon.png", fullPage: true });
  await page.getByRole("button", { name: "Painterly", exact: true }).click();
  await page.screenshot({ path: ".fallow/synty-painterly.png", fullPage: true });
  await page.getByRole("button", { name: "▷ Play", exact: true }).click();
  await page.waitForFunction(
    () => document.querySelector(".synty-playback progress").value >= 0.55,
  );
  await page.screenshot({ path: ".fallow/synty-moving.png", fullPage: true });
  await page.waitForFunction(() => document.querySelector(".synty-playback progress").value === 1);
  await page.getByRole("button", { name: "▷ Replay", exact: true }).click();
  await page.waitForFunction(() => document.querySelector(".synty-playback progress").value < 0.3);
  assert.deepEqual(errors, []);
  console.log("Synty: Toon, Painterly, six-second camera movement and Replay passed.");
} finally {
  await browser.close();
}
