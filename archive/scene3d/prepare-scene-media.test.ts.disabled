it("keeps 3D media within a restorable complete-backup budget", async () => {
  const project = structuredClone(original);
  const media = {
    id: "cached.scene",
    path: "media/cached.webp",
    type: "image" as const,
    alt: "Cached scene",
  };
  const input = mediaDefaults("3D Scene", "intro", "illustration");
  const composer = { prepare: async () => [media] };
  const next = await prepareSceneMedia(project, "en", input, composer);
  expect(next.languages.en!.configuration.assets).toContainEqual(media);
  project.languages.en!.configuration.assets = ["a", "b", "c"].map((id) => ({
    id,
    path: `media/${id}.mp4`,
    type: "video",
    alt: id,
    upload: {
      digest: id.repeat(64),
      mime: "video/mp4",
      size: 50_000_000,
      rights: "Test",
      durationMs: 1000,
    },
  }));
  await expect(prepareSceneMedia(project, "en", input, composer)).rejects.toThrow(/130 MB/);
});
